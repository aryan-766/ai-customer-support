      "required": true,
      "properties": [
        {
          "id": "ticket_id",
          "type": "string",
          "description": "Customer's Zoho support ticket number (e.g. 83097). Use when customer says they have a ticket number.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "order_id",
          "type": "string",
          "description": "Customer's order ID or AWB tracking number from courier. Use when customer provides an order number.",
