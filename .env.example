# ──────────────────────────────────────────────────────────────────────────────
# Ambrane AI Voice Customer Support — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=Ambrane AI Voice Support
APP_ENV=development
DEBUG=true
SECRET_KEY=change_me_to_a_random_64_char_string
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ambrane_support
POSTGRES_USER=ambrane
POSTGRES_PASSWORD=ambrane_secret_password
DATABASE_URL=postgresql+asyncpg://ambrane:ambrane_secret_password@localhost:5432/ambrane_support

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_CALL_STATE=86400
REDIS_TTL_SESSION=1800

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ambrane_kb

# ── AI Models ──────────────────────────────────────────────────────────────────
# STT
STT_PROVIDER=faster_whisper
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30

# TTS
TTS_PROVIDER=kokoro
TTS_VOICE=af_heart
TTS_SAMPLE_RATE=24000

# Embeddings (HuggingFace)
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
INTENT_MODEL=cross-encoder/nli-MiniLM2-L6-H768
LANG_DETECT_MODEL=papluca/xlm-roberta-base-language-detection
MODELS_CACHE_DIR=.models

# ── SIP Bridge (Asterisk / SAN Software) ──────────────────────────────────────
# sip_bridge.py configuration
SIP_BRIDGE_HOST=0.0.0.0
SIP_BRIDGE_PORT=5000
# Audio codec Asterisk se: 'ulaw' (G.711 μ-law) ya 'alaw' (G.711 A-law)
SIP_BRIDGE_CODEC=ulaw
# Asterisk server IP (SAN Software se incoming SIP)
ASTERISK_HOST=localhost
# Backend URLs (sip_bridge.py in use karta hai)
BACKEND_WS_URL=ws://localhost:8000
BACKEND_API_URL=http://localhost:8000

# ── External Integrations ──────────────────────────────────────────────────────
# Zoho Desk
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORG_ID=your_zoho_org_id
ZOHO_DESK_URL=https://desk.zoho.in/api/v1

# NimbusPost (Courier Aggregator / OMS)
NIMBUSPOST_API_KEY=your_nimbuspost_api_key
NIMBUSPOST_BASE_URL=https://api.nimbuspost.com/v1

# Courier APIs (Delhivery, Shiprocket etc.)
DELHIVERY_TOKEN=your_delhivery_token
DELHIVERY_BASE_URL=https://track.delhivery.com/api

# My Product Care (Warranty DB)
MPC_API_KEY=your_mpc_api_key
MPC_BASE_URL=https://api.myproductcare.com/v1

# Notification (SMS / WhatsApp)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=AMBRNE

# ── Knowledge Base ─────────────────────────────────────────────────────────────
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
KB_TOP_K=10
KB_RERANK_TOP_N=3
